# 复制为 .env 后填入你自己的 Key（.env 已被 .gitignore 排除，不要提交）
# 讯飞 Spark（星火 MaaS，OpenAI 兼容接口）：
DIRECTOR_API_KEY=在这里填你的APIKey
DIRECTOR_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2
DIRECTOR_MODEL=spark-x2.6
# 换成任何 OpenAI 兼容服务也可以：改 BASE 和 MODEL 即可，例如
# DIRECTOR_API_BASE=https://api.openai.com/v1
# DIRECTOR_MODEL=gpt-4o-mini
